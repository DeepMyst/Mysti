{
  "name": "mysti",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.4.0",
  "publisher": "DeepMyst",
  "author": {
    "name": "Baha Abunojaim",
    "email": "baha@deepmyst.com",
    "url": "https://www.deepmyst.com/mysti"
  },
  "icon": "resources/Mysti-Logo.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DeepMyst/Mysti"
  },
  "bugs": {
    "url": "https://github.com/DeepMyst/Mysti/issues"
  },
  "homepage": "https://www.deepmyst.com/mysti",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "ai agent",
    "ai assistant",
    "ai coding",
    "ai coding assistant",
    "agentic",
    "anthropic",
    "claude",
    "claude code",
    "cline",
    "code assistant",
    "code generation",
    "codex",
    "coding agent",
    "copilot",
    "cursor",
    "deepseek",
    "gemini",
    "github copilot",
    "llm",
    "multi-agent",
    "multi-model",
    "openclaw",
    "openai",
    "pair programming",
    "productivity"
  ],
  "license": "Apache-2.0",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:claude.md",
    "workspaceContains:CLAUDE.md",
    "workspaceContains:gemini.yaml",
    "workspaceContains:codex.json",
    "workspaceContains:agents.yaml",
    "workspaceContains:mysti.md",
    "workspaceContains:MYSTI.md",
    "workspaceContains:.mysti/config.json",
    "workspaceContains:.mysti/agents.yaml",
    "workspaceContains:.mysti/team.json",
    "workspaceContains:.mysti/rules/**",
    "workspaceContains:.mysti/mysti.md",
    "workspaceContains:.claude/**",
    "workspaceContains:.gemini/**",
    "workspaceContains:.openai/**",
    "workspaceContains:.openclaw/**",
    "workspaceContains:opencode.json",
    "workspaceContains:.qwen/**"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mysti-sidebar",
          "title": "Mysti",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "mysti-sidebar": [
        {
          "type": "webview",
          "id": "mysti.chatView",
          "name": "Mysti"
        }
      ]
    },
    "commands": [
      {
        "command": "mysti.openChat",
        "title": "%command.mysti.openChat.title%",
        "shortTitle": "%command.mysti.openChat.shortTitle%",
        "category": "Mysti"
      },
      {
        "command": "mysti.newConversation",
        "title": "%command.mysti.newConversation.title%",
        "shortTitle": "%command.mysti.newConversation.shortTitle%",
        "category": "Mysti"
      },
      {
        "command": "mysti.addToContext",
        "title": "%command.mysti.addToContext.title%",
        "shortTitle": "%command.mysti.addToContext.shortTitle%",
        "category": "Mysti"
      },
      {
        "command": "mysti.clearContext",
        "title": "%command.mysti.clearContext.title%",
        "category": "Mysti"
      },
      {
        "command": "mysti.openInNewTab",
        "title": "%command.mysti.openInNewTab.title%",
        "shortTitle": "%command.mysti.openInNewTab.shortTitle%",
        "category": "Mysti",
        "icon": {
          "light": "resources/Mysti-Logo.png",
          "dark": "resources/Mysti-Logo.png"
        }
      },
      {
        "command": "mysti.debugSetup",
        "title": "%command.mysti.debugSetup.title%",
        "category": "Mysti"
      },
      {
        "command": "mysti.debugSetupFailure",
        "title": "%command.mysti.debugSetupFailure.title%",
        "category": "Mysti"
      },
      {
        "command": "mysti.toggleAutonomous",
        "title": "%command.mysti.toggleAutonomous.title%",
        "category": "Mysti"
      },
      {
        "command": "mysti.codeLensAction",
        "title": "%command.mysti.codeLensAction.title%",
        "category": "Mysti"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mysti.addToContext",
          "group": "mysti"
        }
      ],
      "editor/context": [
        {
          "command": "mysti.addToContext",
          "group": "mysti"
        }
      ],
      "view/title": [
        {
          "command": "mysti.openInNewTab",
          "when": "view == mysti.chatView",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "mysti.openInNewTab",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Mysti",
      "properties": {
        "mysti.defaultProvider": {
          "type": "string",
          "default": "claude-code",
          "enum": [
            "claude-code",
            "openai-codex",
            "google-gemini",
            "cline",
            "github-copilot",
            "cursor",
            "openclaw",
            "opencode",
            "ollama",
            "localai",
            "qwen-code"
          ],
          "enumDescriptions": [
            "%config.mysti.defaultProvider.enumDescriptions.0%",
            "%config.mysti.defaultProvider.enumDescriptions.1%",
            "%config.mysti.defaultProvider.enumDescriptions.2%",
            "%config.mysti.defaultProvider.enumDescriptions.3%",
            "%config.mysti.defaultProvider.enumDescriptions.4%",
            "%config.mysti.defaultProvider.enumDescriptions.5%",
            "%config.mysti.defaultProvider.enumDescriptions.6%",
            "%config.mysti.defaultProvider.enumDescriptions.7%",
            "%config.mysti.defaultProvider.enumDescriptions.8%",
            "%config.mysti.defaultProvider.enumDescriptions.9%",
            "%config.mysti.defaultProvider.enumDescriptions.10%"
          ],
          "description": "%config.mysti.defaultProvider.description%"
        },
        "mysti.claudeCodePath": {
          "type": "string",
          "default": "claude",
          "description": "%config.mysti.claudeCodePath.description%"
        },
        "mysti.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "%config.mysti.codexPath.description%"
        },
        "mysti.geminiPath": {
          "type": "string",
          "default": "gemini",
          "description": "%config.mysti.geminiPath.description%"
        },
        "mysti.clinePath": {
          "type": "string",
          "default": "cline",
          "description": "%config.mysti.clinePath.description%"
        },
        "mysti.copilotPath": {
          "type": "string",
          "default": "copilot",
          "description": "%config.mysti.copilotPath.description%"
        },
        "mysti.cursorPath": {
          "type": "string",
          "default": "agent",
          "description": "%config.mysti.cursorPath.description%"
        },
        "mysti.cursorApiKey": {
          "type": "string",
          "default": "",
          "description": "%config.mysti.cursorApiKey.description%"
        },
        "mysti.openclawPath": {
          "type": "string",
          "default": "openclaw",
          "description": "%config.mysti.openclawPath.description%"
        },
        "mysti.openclawGatewayUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:18789",
          "description": "%config.mysti.openclawGatewayUrl.description%"
        },
        "mysti.openclawUseGateway": {
          "type": "boolean",
          "default": true,
          "description": "%config.mysti.openclawUseGateway.description%"
        },
        "mysti.opencodePath": {
          "type": "string",
          "default": "opencode",
          "description": "%config.mysti.opencodePath.description%"
        },
        "mysti.qwenCodePath": {
          "type": "string",
          "default": "qwen",
          "description": "%config.mysti.qwenCodePath.description%"
        },
        "mysti.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "%config.mysti.ollamaEndpoint.description%"
        },
        "mysti.ollamaModel": {
          "type": "string",
          "default": "",
          "description": "%config.mysti.ollamaModel.description%"
        },
        "mysti.ollamaTemperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "%config.mysti.ollamaTemperature.description%"
        },
        "mysti.ollamaContextLength": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%config.mysti.ollamaContextLength.description%"
        },
        "mysti.ollamaKeepAlive": {
          "type": "string",
          "default": "5m",
          "description": "%config.mysti.ollamaKeepAlive.description%"
        },
        "mysti.ollamaRequestTimeout": {
          "type": "number",
          "default": 120000,
          "minimum": 5000,
          "description": "%config.mysti.ollamaRequestTimeout.description%"
        },
        "mysti.localaiEndpoint": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "%config.mysti.localaiEndpoint.description%"
        },
        "mysti.localaiModel": {
          "type": "string",
          "default": "",
          "description": "%config.mysti.localaiModel.description%"
        },
        "mysti.localaiTemperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "%config.mysti.localaiTemperature.description%"
        },
        "mysti.localaiMaxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%config.mysti.localaiMaxTokens.description%"
        },
        "mysti.localaiApiKey": {
          "type": "string",
          "default": "",
          "description": "%config.mysti.localaiApiKey.description%"
        },
        "mysti.localaiRequestTimeout": {
          "type": "number",
          "default": 120000,
          "minimum": 5000,
          "description": "%config.mysti.localaiRequestTimeout.description%"
        },
        "mysti.defaultMode": {
          "type": "string",
          "default": "ask-before-edit",
          "enum": [
            "ask-before-edit",
            "edit-automatically",
            "plan"
          ],
          "description": "%config.mysti.defaultMode.description%"
        },
        "mysti.defaultThinkingLevel": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ],
          "description": "%config.mysti.defaultThinkingLevel.description%"
        },
        "mysti.defaultModel": {
          "type": "string",
          "default": "claude-sonnet-4-5-20250929",
          "description": "%config.mysti.defaultModel.description%"
        },
        "mysti.claudeCodeModel": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9._\\-:/]*$",
          "maxLength": 128,
          "description": "%config.mysti.claudeCodeModel.description%"
        },
        "mysti.codexModel": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9._\\-:/]*$",
          "maxLength": 128,
          "description": "%config.mysti.codexModel.description%"
        },
        "mysti.codexProfile": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9._\\-]*$",
          "maxLength": 64,
          "description": "%config.mysti.codexProfile.description%"
        },
        "mysti.geminiModel": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9._\\-:/]*$",
          "maxLength": 128,
          "description": "%config.mysti.geminiModel.description%"
        },
        "mysti.clineModel": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9._\\-:/]*$",
          "maxLength": 128,
          "description": "%config.mysti.clineModel.description%"
        },
        "mysti.copilotModel": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9._\\-:/]*$",
          "maxLength": 128,
          "description": "%config.mysti.copilotModel.description%"
        },
        "mysti.cursorModel": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9._\\-:/]*$",
          "maxLength": 128,
          "description": "%config.mysti.cursorModel.description%"
        },
        "mysti.openclawModel": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9._\\-:/]*$",
          "maxLength": 128,
          "description": "%config.mysti.openclawModel.description%"
        },
        "mysti.opencodeModel": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9._\\-:/]*$",
          "maxLength": 128,
          "description": "%config.mysti.opencodeModel.description%"
        },
        "mysti.qwenCodeModel": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9._\\-:/]*$",
          "maxLength": 128,
          "description": "%config.mysti.qwenCodeModel.description%"
        },
        "mysti.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.mysti.codeLens.enabled.description%"
        },
        "mysti.accessLevel": {
          "type": "string",
          "default": "ask-permission",
          "enum": [
            "read-only",
            "ask-permission",
            "full-access"
          ],
          "enumDescriptions": [
            "%config.mysti.accessLevel.enumDescriptions.0%",
            "%config.mysti.accessLevel.enumDescriptions.1%",
            "%config.mysti.accessLevel.enumDescriptions.2%"
          ],
          "description": "%config.mysti.accessLevel.description%"
        },
        "mysti.autoContext": {
          "type": "boolean",
          "default": true,
          "description": "%config.mysti.autoContext.description%"
        },
        "mysti.planDetection.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.mysti.planDetection.enabled.description%"
        },
        "mysti.compaction.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.mysti.compaction.enabled.description%"
        },
        "mysti.compaction.threshold": {
          "type": "number",
          "default": 75,
          "minimum": 50,
          "maximum": 95,
          "description": "%config.mysti.compaction.threshold.description%"
        },
        "mysti.activeMode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.mysti.activeMode.enabled.description%"
        },
        "mysti.activeMode.pollInterval": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 300,
          "description": "%config.mysti.activeMode.pollInterval.description%"
        },
        "mysti.activeMode.showActivityFeed": {
          "type": "boolean",
          "default": true,
          "description": "%config.mysti.activeMode.showActivityFeed.description%"
        },
        "mysti.activeMode.activityLimit": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 200,
          "description": "%config.mysti.activeMode.activityLimit.description%"
        },
        "mysti.activeMode.autoStartDaemon": {
          "type": "boolean",
          "default": false,
          "description": "%config.mysti.activeMode.autoStartDaemon.description%"
        },
        "mysti.lifecycle.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.mysti.lifecycle.enabled.description%"
        },
        "mysti.lifecycle.idleTimeoutMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 1440,
          "description": "%config.mysti.lifecycle.idleTimeoutMinutes.description%"
        },
        "mysti.lifecycle.processTreeTracking": {
          "type": "boolean",
          "default": true,
          "description": "%config.mysti.lifecycle.processTreeTracking.description%"
        },
        "mysti.lifecycle.protectActiveChildren": {
          "type": "boolean",
          "default": true,
          "description": "%config.mysti.lifecycle.protectActiveChildren.description%"
        },
        "mysti.lifecycle.checkIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 300,
          "description": "%config.mysti.lifecycle.checkIntervalSeconds.description%"
        },
        "mysti.showSuggestions": {
          "type": "boolean",
          "default": true,
          "description": "%config.mysti.showSuggestions.description%"
        },
        "mysti.brainstorm.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.mysti.brainstorm.enabled.description%"
        },
        "mysti.brainstorm.strategy": {
          "type": "string",
          "default": "quick",
          "enum": [
            "quick",
            "debate",
            "red-team",
            "perspectives",
            "delphi"
          ],
          "enumDescriptions": [
            "%config.mysti.brainstorm.strategy.enumDescriptions.0%",
            "%config.mysti.brainstorm.strategy.enumDescriptions.1%",
            "%config.mysti.brainstorm.strategy.enumDescriptions.2%",
            "%config.mysti.brainstorm.strategy.enumDescriptions.3%",
            "%config.mysti.brainstorm.strategy.enumDescriptions.4%"
          ],
          "description": "%config.mysti.brainstorm.strategy.description%"
        },
        "mysti.brainstorm.discussionMode": {
          "type": "string",
          "default": "quick",
          "enum": [
            "quick",
            "full"
          ],
          "enumDescriptions": [
            "%config.mysti.brainstorm.discussionMode.enumDescriptions.0%",
            "%config.mysti.brainstorm.discussionMode.enumDescriptions.1%"
          ],
          "description": "%config.mysti.brainstorm.discussionMode.description%",
          "deprecationMessage": "Use mysti.brainstorm.strategy instead"
        },
        "mysti.brainstorm.maxDiscussionRounds": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 3,
          "description": "%config.mysti.brainstorm.maxDiscussionRounds.description%"
        },
        "mysti.brainstorm.discussionRounds": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 3,
          "description": "%config.mysti.brainstorm.discussionRounds.description%",
          "deprecationMessage": "Use mysti.brainstorm.maxDiscussionRounds instead"
        },
        "mysti.brainstorm.autoConverge": {
          "type": "boolean",
          "default": true,
          "description": "%config.mysti.brainstorm.autoConverge.description%"
        },
        "mysti.brainstorm.synthesisAgent": {
          "type": "string",
          "default": "claude-code",
          "enum": [
            "claude-code",
            "openai-codex",
            "google-gemini",
            "cline",
            "github-copilot",
            "cursor",
            "openclaw",
            "opencode",
            "ollama",
            "localai",
            "qwen-code"
          ],
          "description": "%config.mysti.brainstorm.synthesisAgent.description%"
        },
        "mysti.brainstorm.agents": {
          "type": "array",
          "default": [
            "claude-code",
            "openai-codex"
          ],
          "items": {
            "type": "string",
            "enum": [
              "claude-code",
              "openai-codex",
              "google-gemini",
              "cline",
              "github-copilot",
              "cursor",
              "openclaw",
              "opencode",
              "ollama",
              "localai",
              "qwen-code"
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "description": "%config.mysti.brainstorm.agents.description%"
        },
        "mysti.agents.claudePersona": {
          "type": "string",
          "default": "neutral",
          "enum": [
            "neutral",
            "architect",
            "pragmatist",
            "engineer",
            "reviewer",
            "designer",
            "custom"
          ],
          "enumDescriptions": [
            "%config.mysti.agents.claudePersona.enumDescriptions.0%",
            "%config.mysti.agents.claudePersona.enumDescriptions.1%",
            "%config.mysti.agents.claudePersona.enumDescriptions.2%",
            "%config.mysti.agents.claudePersona.enumDescriptions.3%",
            "%config.mysti.agents.claudePersona.enumDescriptions.4%",
            "%config.mysti.agents.claudePersona.enumDescriptions.5%",
            "%config.mysti.agents.claudePersona.enumDescriptions.6%"
          ],
          "description": "%config.mysti.agents.claudePersona.description%"
        },
        "mysti.agents.claudeCustomPrompt": {
          "type": "string",
          "default": "",
          "description": "%config.mysti.agents.claudeCustomPrompt.description%"
        },
        "mysti.agents.codexPersona": {
          "type": "string",
          "default": "neutral",
          "enum": [
            "neutral",
            "architect",
            "pragmatist",
            "engineer",
            "reviewer",
            "designer",
            "custom"
          ],
          "enumDescriptions": [
            "%config.mysti.agents.codexPersona.enumDescriptions.0%",
            "%config.mysti.agents.codexPersona.enumDescriptions.1%",
            "%config.mysti.agents.codexPersona.enumDescriptions.2%",
            "%config.mysti.agents.codexPersona.enumDescriptions.3%",
            "%config.mysti.agents.codexPersona.enumDescriptions.4%",
            "%config.mysti.agents.codexPersona.enumDescriptions.5%",
            "%config.mysti.agents.codexPersona.enumDescriptions.6%"
          ],
          "description": "%config.mysti.agents.codexPersona.description%"
        },
        "mysti.agents.codexCustomPrompt": {
          "type": "string",
          "default": "",
          "description": "%config.mysti.agents.codexCustomPrompt.description%"
        },
        "mysti.agents.geminiPersona": {
          "type": "string",
          "default": "neutral",
          "enum": [
            "neutral",
            "architect",
            "pragmatist",
            "engineer",
            "reviewer",
            "designer",
            "custom"
          ],
          "enumDescriptions": [
            "%config.mysti.agents.geminiPersona.enumDescriptions.0%",
            "%config.mysti.agents.geminiPersona.enumDescriptions.1%",
            "%config.mysti.agents.geminiPersona.enumDescriptions.2%",
            "%config.mysti.agents.geminiPersona.enumDescriptions.3%",
            "%config.mysti.agents.geminiPersona.enumDescriptions.4%",
            "%config.mysti.agents.geminiPersona.enumDescriptions.5%",
            "%config.mysti.agents.geminiPersona.enumDescriptions.6%"
          ],
          "description": "%config.mysti.agents.geminiPersona.description%"
        },
        "mysti.agents.geminiCustomPrompt": {
          "type": "string",
          "default": "",
          "description": "%config.mysti.agents.geminiCustomPrompt.description%"
        },
        "mysti.agents.clinePersona": {
          "type": "string",
          "default": "neutral",
          "enum": [
            "neutral",
            "architect",
            "pragmatist",
            "engineer",
            "reviewer",
            "designer",
            "custom"
          ],
          "enumDescriptions": [
            "%config.mysti.agents.clinePersona.enumDescriptions.0%",
            "%config.mysti.agents.clinePersona.enumDescriptions.1%",
