{
  "version": "2.0.0",
  "tasks": [
    {
      // The default build. `npm run watch` is `webpack --mode development
      // --watch`, so the matcher must be a WEBPACK one: this task used to
      // declare "$tsc-watch", whose begin/end markers webpack never prints.
      // Anything relying on that matcher to know the build had settled would
      // have waited forever.
      "label": "watch",
      "type": "npm",
      "script": "watch",
      "problemMatcher": {
        "owner": "webpack",
        "source": "webpack",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*(ERROR|WARNING) in (.*?)(?::(\\d+):(\\d+))?$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 0
        }
      },
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      // One-shot development build that F5 runs first (launch.json). One-shot,
      // not `watch`: a background task gives the launch no signal that the
      // build settled, and a stale dist/ pairs the old host with the current
      // media/ webview, which is read from disk.
      "label": "compile-dev",
      "type": "npm",
      "script": "compile:dev",
      "problemMatcher": {
        "owner": "webpack",
        "source": "webpack",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*(ERROR|WARNING) in (.*?)(?::(\\d+):(\\d+))?$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 0
        }
      },
      "presentation": { "reveal": "silent" },
      "group": "build"
    },
    {
      // One-shot production build — what `vscode:prepublish` runs.
      "label": "compile",
      "type": "npm",
      "script": "compile",
      "problemMatcher": {
        "owner": "webpack",
        "source": "webpack",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*(ERROR|WARNING) in (.*?)(?::(\\d+):(\\d+))?$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 0
        }
      },
      "group": "build"
    }
  ]
}
