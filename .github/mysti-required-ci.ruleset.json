          { "context": "gates (windows-latest)", "integration_id": 15368 },
          { "context": "test (ubuntu-latest)", "integration_id": 15368 },
          { "context": "test (macos-latest)", "integration_id": 15368 },
          { "context": "test (windows-latest)", "integration_id": 15368 },
          { "context": "lint", "integration_id": 15368 },
          { "context": "bundled runtime (Node 18.17.1)", "integration_id": 15368 },
          { "context": "package shape", "integration_id": 15368 },
          { "context": "packaged VS Code (1.86.0)", "integration_id": 15368 },
          { "context": "packaged VS Code (stable)", "integration_id": 15368 },
          { "context": "VS Code host (ubuntu-latest, stable)", "integration_id": 15368 },
          { "context": "VS Code host (macos-latest, stable)", "integration_id": 15368 },
          { "context": "VS Code host (windows-latest, stable)", "integration_id": 15368 },
          { "context": "VS Code host (ubuntu-latest, 1.86.0)", "integration_id": 15368 }
        ]
